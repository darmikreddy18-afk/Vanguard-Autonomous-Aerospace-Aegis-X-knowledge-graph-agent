GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-flash-lite
# FALKORDB_URL=redis://localhost:6379
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...  (optional: enables "Send via Slack")

# Enables POST /api/ingest (the demo "newer fact arrives" endpoint). Leave unset on any public deployment.
# DEMO_INGEST=1
# SNAPSHOT_TTL_MS=30000   (lower, e.g. 1000, if you reset the graph with `npm run seed` between demo takes)
